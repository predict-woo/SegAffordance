#!/usr/bin/env python3
"""spotctl: thin client for spotd. No ROS imports, answers in ~50 ms.

  spotctl status            spotctl pose 0.7 0 0.3 -p 15        spotctl go half
  spotctl stand             spotctl nudge -z 0.05               spotctl stop
Exit code 0 on OK, 1 on ERR, 2 if the daemon is not running.
"""
import os
import socket
import sys

SOCK = os.environ.get("SPOTD_SOCK", "/tmp/spotd.sock")


def main():
    args = sys.argv[1:] or ["help"]
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except (FileNotFoundError, ConnectionRefusedError):
        print(f"spotd is not running (no socket at {SOCK}). Start it:  ~/andrew_ws/spotd.sh   (or: tmux new -d -s spotd ~/andrew_ws/spotd.sh)", file=sys.stderr)
        sys.exit(2)
    s.settimeout(130)
    s.sendall(("\t".join(args) + "\n").encode())
    buf = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    s.close()
    text = buf.decode().rstrip("\n")
    ok = text.startswith("OK")
    body = text[3:] if text[:3] in ("OK ", "ERR") else text
    if text.startswith("ERR "):
        body = text[4:]
    print(body)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
