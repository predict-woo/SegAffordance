__pycache__/
*.pyc
.DS_Store

# run outputs
wandb/
test_visualizations/
*.out
*.png
*.tar.gz
*.log

# experiments/: notes, configs, metrics and vis summaries ARE tracked;
# heavy artifacts stay on the volume / out of git
experiments/**/checkpoints/
experiments/**/logs/
# vis/ = prediction-panel PNGs (megabytes). vis_summary.txt IS tracked.
experiments/**/vis/

# CLIP weights: symlink to /workspace/models/RN50.pt, created by runpod/setup.sh
pretrain/RN50.pt

# viz/: dated visualization batches (see CLAUDE.md). Per-batch README.md,
# manifest.yaml and the INDEX are tracked; the images themselves are not
# (they live on both sides of the mutagen mirror).
viz/**
!viz/*/
!viz/INDEX.md
!viz/*/README.md
!viz/*/manifest.yaml
